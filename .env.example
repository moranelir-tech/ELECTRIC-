# כתובת האתר (ל-sitemap, canonical ו-Schema)
SITE_URL=https://example.co.il

# סיסמת פאנל הניהול (/admin) - חובה להחליף
ADMIN_PASSWORD=change-me

# מחרוזת אקראית ארוכה לחתימת ה-session (למשל: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# אופציונלי: כל ליד חדש נשלח ב-POST (JSON) לכתובת הזו (Zapier / Make / CRM)
LEADS_WEBHOOK_URL=

# אופציונלי: תיקיית הנתונים (ברירת מחדל: ./data). בשרת מומלץ נתיב קבוע מחוץ לקוד
DATA_DIR=

# on = מאפשר אינדוקס בגוגל (לפרסום). ברירת מחדל: noindex
SITE_INDEXING=off
